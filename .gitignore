###############################################################################
# STM32 测试项目仓库 —— 根目录 .gitignore
#
# 适用场景:
#   1) STM32CubeMX 生成的工程 (CMake + CubeCLT / CubeIDE 格式)
#   2) 从外部复制进来的 Keil MDK-ARM 工程
#   3) GUI/ 下的 Python 上位机脚本
#
# 规则写在仓库根目录, 对 hello/、hello_imu/、CtrBoard-H7_IMU/ 等子目录同样生效。
###############################################################################

# ---------------------------------------------------------------------------
# 0. 操作系统 / 编辑器 / IDE 临时文件
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*~
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej
*.log

# ---------------------------------------------------------------------------
# 1. CMake / Ninja 构建产物
# ---------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log
*.ninja
Testing/
# 本地预设覆盖文件 (每个人的工具链路径不同, 不应提交)
CMakeUserPresets.json

# 语言服务 / IntelliSense 索引缓存
.cache/
.vscode/ipch/

# ---------------------------------------------------------------------------
# 2. STM32CubeMX 生成与备份文件
# ---------------------------------------------------------------------------
mx.scratch
*.ioc.bak
*.ioc.tmp
# CubeIDE/CubeCLT 的工程元数据, 若团队需要共享可取消下面一行的注释
#.mxproject

# 注意: .settings/ 由 CubeIDE/CubeCLT 生成, 但子工程中已显式保留 (!.settings),
#       因此这里不做忽略。
# 注意: .project / .cproject / UI 配置文件是工程本体, 必须提交。

# ---------------------------------------------------------------------------
# 3. Keil MDK-ARM 产物
# ---------------------------------------------------------------------------
# 目标输出目录, 形如 MDK-ARM/<工程名>/ (存放 .o/.axf/.hex/...)
MDK-ARM/*/
# DebugConfig/*.dbgconf 记录器件调试配置, 体积小, 予以保留
!MDK-ARM/DebugConfig/

# 一般位于工程根目录的输出目录 (部分复制的 Keil 工程不带 MDK-ARM 层)
Objects/
Listings/
RTE/

# 用户级配置 (窗口布局、断点、打开的文件列表), 每人不同
*.uvguix.*
*.uvoptx

# 编译/链接中间文件
*.dep
*.crf
*.o
*.d
*.lnp
*.iex
*.su
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.htm
*.build_log.htm

# 注意: *.uvprojx (工程文件) 与 EventRecorderStub.scvd 需要提交, 不要忽略。

# ---------------------------------------------------------------------------
# 4. IAR EWARM 产物 (若以后复制 IAR 工程)
# ---------------------------------------------------------------------------
Debug/
Release/
*.ewt
*.ewd
*.ewb
*.dep

# ---------------------------------------------------------------------------
# 5. 调试器 / 下载工具日志
# ---------------------------------------------------------------------------
JLinkLog.txt
*.jlinklog
*.jflashlog
stlink*.log
*.svd

# ---------------------------------------------------------------------------
# 6. Python (GUI 上位机)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# 本机串口号等本地配置, 复制 config.ini.example 后自行填写
**/GUI/config.ini
